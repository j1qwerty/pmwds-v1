# PMWDS backend configuration. Copy to .env and update local values.
# In Development, you can also use .NET User Secrets (dotnet user-secrets set ...).

# ── Database ──────────────────────────────────────────────
# SQL Server is attempted first; SQLite fallback in Development.
#
# SQL Server AUTHENTICATION ONLY. Do not use Trusted_Connection=True /
# Integrated Security=True here: Windows authentication does not exist on
# Linux, so it works on a Windows dev box and fails on the Ubuntu VPS. Every
# deployed environment must supply User Id + Password.
#
# Use 127.0.0.1 rather than localhost - some SQL Server instances (including the
# official Linux container) do not answer on ::1, and the connection hangs until
# it times out.
#
# TrustServerCertificate=True is required for the self-signed certificate the
# SQL Server container generates on first run.
#
# Do NOT add MultipleActiveResultSets=true. EF Core enables a retry strategy for
# SQL Server (EnableRetryOnFailure), and that strategy relies on savepoints -
# MARS disables them, so EF logs "Savepoints are disabled because Multiple Active
# Result Sets is enabled" on every save and cannot roll back a failed transaction
# to a clean state before retrying. EF Core does not need MARS.
ConnectionStrings__Default=Server=127.0.0.1,1433;Database=PMWDS;User Id=sa;Password=CHANGE_ME_Strong_Passw0rd;TrustServerCertificate=True
ConnectionStrings__Hangfire=Server=127.0.0.1,1433;Database=PMWDS_Hangfire;User Id=sa;Password=CHANGE_ME_Strong_Passw0rd;TrustServerCertificate=True

# Redis is used for app cache. Optional: if Redis is unreachable the app logs a
# warning and falls back to an in-memory distributed cache.
ConnectionStrings__Redis=localhost:6379

# Database fallback switches. ForceSqlite is allowed only in Development.
Database__ForceSqlite=false
Database__SqliteConnectionString=Data Source=App_Data/pmwds-dev.sqlite

# Production on SQL Server: keep ForceSqlite false and leave the SQLite opt-in
# off, so a bad connection string fails loudly instead of silently starting on an
# empty SQLite file.
Database__AllowSqliteInProduction=false

# Production on SQLite (single instance, no Hangfire) - opt in explicitly and use
# an absolute path outside the publish folder so the DB survives redeploys.
# Database__AllowSqliteInProduction=true
# Database__SqliteConnectionString=Data Source=/var/lib/pmwds/database/pmwds.sqlite

# ── JWT ──────────────────────────────────────────────────
# Generate a cryptographically random secret (≥64 chars) for production.
Jwt__Secret=<replace-with-random-secret-min-64-chars>
Jwt__Issuer=PMWDS
Jwt__Audience=PMWDS_Users
Jwt__ExpiryMinutes=30
Jwt__RefreshTokenDays=14

# ── AI Providers ─────────────────────────────────────────
# Leave API keys empty to manage providers from the Settings page.
# Model size dominates report latency: a 550B free-tier model can take
# minutes per report. Raise the timeout, or switch to a smaller model for
# faster generation.
AI__DefaultProvider=OpenRouter
AI__DefaultModel=nvidia/nemotron-3-ultra-550b-a55b:free
# Provider call timeout. The .NET HttpClient default is 100s, which is too
# short for large structured report completions on a large model.
AI__RequestTimeoutSeconds=600
AI__MaxOutputTokens=16000
AI__OpenAIApiKey=
AI__OpenAI__ApiKey=
AI__OpenAI__BaseUrl=https://api.openai.com/v1
AI__OpenAI__DefaultModel=gpt-4o
AI__OpenRouter__ApiKey=
AI__OpenRouter__BaseUrl=https://openrouter.ai/api/v1
AI__OpenRouter__DefaultModel=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Email / SMTP ─────────────────────────────────────────
# Provide your own SMTP credentials.
Email__Host=
Email__Port=587
Email__Username=
Email__Password=
Email__SenderEmail=no-reply@pmwds.local
Email__SenderName=PMWDS
Email__UseSsl=true
Email__ClientBaseUrl=http://localhost:5173
Email__PasswordResetMinutes=30

# Optional seed-only webhook signing secret. Webhook seed records are skipped when unset.
PMWDS_SEED_WEBHOOK_SECRET=
