{
  "ConnectionStrings": {
    "Default": "",
    "Redis": "localhost:6379",
    "Hangfire": ""
  },
  "Database": {
    "ForceSqlite": false,
    "AllowSqliteInProduction": true,
    "SqliteConnectionString": "Data Source=/var/lib/pmwds/database/pmwds.sqlite"
  },
  "AzureStorage": {
    "LocalUploadPath": "/var/lib/pmwds/data",
    "LocalBaseUrl": "/files"
  },
  "Jwt": {
    "ExpiryMinutes": 1440
  },
  "AI": {
    "AppUrl": "https://pmwds.dharmaatribe.app",
    "OpenRouter": {
      "Headers": {
        "HTTP-Referer": "https://pmwds.dharmaatribe.app",
        "X-OpenRouter-Title": "PMWDS"
      }
    }
  },
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "FileStorage": {
    "BasePath": "/var/lib/pmwds/data",
    "AvatarsPath": "avatars",
    "DocumentsPath": "documents"
  },
  "AllowedOrigins": [
    "https://pmwds.dharmaatribe.app"
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  }
}