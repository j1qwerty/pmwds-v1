{
  "ConnectionStrings": {
    "Default": "",
    "Redis": "localhost:6379",
    "Hangfire": ""
  },
  "Database": {
    "ForceSqlite": false,
    "SqliteConnectionString": "Data Source=App_Data/pmwds-v1.sqlite"
  },
  "AzureStorage": {
    "LocalUploadPath": "App_Data",
    "LocalBaseUrl": "/files"
  },
  "FileStorage": {
    "BasePath": "App_Data",
    "AvatarsPath": "avatars",
    "DocumentsPath": "documents"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Information",
        "System": "Warning"
      }
    }
  }
}
